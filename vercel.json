{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Android|iPhone|iPod|Mobile|android|iphone|mobile).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "site"
        }
      ],
      "destination": "/links.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-cache"
        }
      ]
    }
  ]
}
